---
import { GraduationCap, Linkedin, Youtube } from 'lucide-react';
import { ROUTES } from '../config';

const QUICK_LINKS = [
  { label: 'Home', to: ROUTES.HOME },
  { label: 'What We Offer', to: ROUTES.WHAT_WE_OFFER },
  { label: 'About', to: ROUTES.ABOUT },
  { label: 'Subjects', to: ROUTES.SUBJECTS },
  { label: 'Pricing', to: ROUTES.PRICING },
];

const RESOURCE_LINKS = [
  { label: 'FAQ', to: ROUTES.FAQ },
  { label: 'Contact', to: ROUTES.CONTACT },
  { label: 'Blog', to: ROUTES.BLOG },
  { label: 'Terms & Conditions', to: ROUTES.TERMS_CONDITIONS },
];
---

<footer class="bg-black text-white ">
  <div class="container mx-auto px-4 pt-10 pb-5">
    <div class="grid grid-cols-1 gap-y-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3 xl:grid-cols-[1.35fr_0.8fr_1fr_0.95fr] xl:gap-x-14 items-start">
      <div class="max-w-sm">
        <a href={ROUTES.HOME} class="inline-flex items-center gap-2.5 shrink-0">
          <span class="w-11 h-11 rounded-lg bg-primary text-white flex items-center justify-center">
            <GraduationCap size={28} />
          </span>
          <span class="text-white font-semibold text-lg  tracking-tight">
            Online Class Writers
          </span>
        </a>
        <p class="mt-2 text-gray-300 max-w-xs text-base">
          Professional online class help, tutoring, and academic writing
          help for busy college students. Fast, confidential, and reliable.
        </p>

        <div class="mt-4 flex items-center gap-4">
          <img src="/us.webp" alt="USA Map Icon" class="h-9 w-auto" />
          <p class="text-base md:text-lg font-medium md:font-semibold text-white">
            WE ARE 100% BASED IN THE USA
          </p>
        </div>

        <button
          type="button"
          data-footer-get-help
          class="mt-5 bg-primary hover:bg-orange-400 text-white px-5 py-2.5 rounded-md transition-colors cursor-pointer"
        >
          Get Help Now
        </button>
      </div>

      <div class="xl:justify-self-center">
        <h3 class="text-lg font-medium mb-4.5">Quick Links</h3>
        <ul class="space-y-2 text-gray-300">
          {
            QUICK_LINKS.map((link) => (
              <li>
                <a href={link.to} class="hover:text-white text-base transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="xl:justify-self-center">
        <h3 class="text-lg font-medium mb-4.5">Resources & Legal</h3>
        <ul class="space-y-2 text-gray-300">
          {
            RESOURCE_LINKS.map((link) => (
              <li>
                <a href={link.to} class="hover:text-white transition-colors text-base">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="xl:justify-self-end xl:min-w-64">
        <h3 class="text-lg font-medium mb-4.5">Contact Support</h3>

        <button
          type="button"
          data-footer-email-us
          class="bg-primary hover:bg-orange-400 text-white px-5 py-2.5 rounded-md transition-colors"
        >
          Email Us
        </button>

        <div class="mt-5 flex items-center gap-3 text-gray-300">
          <a
            href="https://www.linkedin.com/in/online-class-writers-1a2859380"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="hover:text-white"
          >
            <Linkedin size={18} />
          </a>
          <a
            href="https://youtube.com/@onlineclasswriters?si=ZxpLfSf7zjKNEDey"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="hover:text-white"
          >
            <Youtube size={18} />
          </a>
          <a
            href="https://x.com/_tutorsupport?s=21"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X"
            class="hover:text-white text-lg leading-none"
          >
            X
          </a>
        </div>

        <div class="mt-4 flex items-center gap-2 flex-wrap">
          <img src="/paypallogo.png" alt="PayPal Logo" class="h-8 w-auto" />
          <img src="/ae.png" alt="American Express Logo" class="h-8 w-auto" />
          <img src="/stripe.png" alt="Stripe Logo" class="h-8 w-auto" />
          <img src="/visalogo.png" alt="Visa Logo" class="h-8 w-auto" />
        </div>
      </div>
    </div>

    <div class="mt-8 pt-4 text-center text-gray-300">
      &copy; 2026 OnlineClassWriters.com. All rights reserved.
    </div>
  </div>
</footer>

<script>
  import { handleGetHelp } from '../utils/getHelp';

  document
    .querySelector('[data-footer-get-help]')
    ?.addEventListener('click', handleGetHelp);

  document.querySelector('[data-footer-email-us]')?.addEventListener('click', () => {
    window.open(
      'https://mail.google.com/mail/?view=cm&fs=1&tf=1&to=qualitywriters400@gmail.com',
      '_blank',
      'noopener,noreferrer',
    );
  });
</script>
