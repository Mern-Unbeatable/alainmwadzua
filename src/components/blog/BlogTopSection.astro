---
import blogPosts from '../../data/blogPosts.json';

const blogPostPath = (slug) => `/blog/${slug}`;

const [featuredPost, ...latestPosts] = blogPosts;
---

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
  <a
    href={blogPostPath(featuredPost.slug)}
    class="lg:col-span-2 relative rounded-3xl overflow-hidden shadow-lg h-100 lg:h-full group cursor-pointer block"
    data-reveal="card"
    style="--reveal-delay: 40ms"
  >
    <img
      src={featuredPost.heroImage}
      alt={featuredPost.title}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>

    <div class="absolute bottom-0 left-0 p-6 md:p-10 w-full">
      <h1 class="text-white text-3xl md:text-4xl font-medium mb-4 leading-tight">
        {featuredPost.title}
      </h1>
      <div class="flex items-center text-gray-300 text-sm md:text-base font-medium">
        <span>{featuredPost.date}</span>
        <span class="mx-2">•</span>
        <span>{featuredPost.readTime}</span>
      </div>
    </div>
  </a>

  {/* Right Column - Dictates the overall height on Desktop */}
  <div
    class="flex flex-col h-full justify-between"
    data-reveal="text"
    style="--reveal-delay: 100ms"
  >
    <h2 class="text-2xl font-bold text-[#1a2b4c] mb-6">Latest post</h2>
    <div class="flex flex-col gap-6">
      {
        latestPosts.map((post, index) => (
          <a
            href={blogPostPath(post.slug)}
            class="flex items-center gap-4 group cursor-pointer"
            data-reveal="card"
            style={`--reveal-delay: ${140 + index * 55}ms`}
          >
            <div class="w-24 h-24 shrink-0 overflow-hidden rounded-xl">
              <img
                src={post.heroImage}
                alt={post.title}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
            </div>
            <div class="flex flex-col justify-center">
              <h3 class="text-base font-medium text-[#1a2b4c] leading-snug group-hover:text-[#FF6B00] transition-colors line-clamp-3">
                {post.title}
              </h3>
              <div class="flex items-center text-gray-500 text-sm mt-2 font-medium">
                <span>{post.date}</span>
                <span class="mx-1.5">•</span>
                <span>{post.readTime}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
