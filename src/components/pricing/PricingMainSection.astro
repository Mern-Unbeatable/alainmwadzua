---
import QuoteForm from './QuoteForm.jsx';
import TrustSidebar from './TrustSidebar.astro';
---

<main class="container mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-8 pb-20">
  <div class="lg:col-span-7" data-reveal="card" style="--reveal-delay: 70ms">
    <QuoteForm client:load />
  </div>

  <div class="lg:col-span-5" data-reveal="card" style="--reveal-delay: 130ms">
    <TrustSidebar />
  </div>
</main>
