---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { generateMetadata } from '../utils/seo';
import { SEO_CONFIG } from '../config';

/**
 * `seo` sets per-page metadata: { title, description, image?, type?,
 * noindex?, structuredData? }. Pages without it fall back to site defaults,
 * so every page still gets a description and a canonical URL.
 */
const { seo = {} } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const siteUrl = Astro.site ?? Astro.url;

const metadata = generateMetadata({
  ...seo,
  description: seo.description || SEO_CONFIG.DEFAULT_DESCRIPTION,
  image: new URL(seo.image || SEO_CONFIG.DEFAULT_IMAGE, siteUrl).href,
  url: new URL(pathname, siteUrl).href,
});

const title = metadata.title;

const metaTags = [
  { name: 'description', content: metadata.description },
  { name: 'keywords', content: metadata.keywords },
  { name: 'robots', content: seo.noindex ? 'noindex, follow' : '' },
  { property: 'og:title', content: metadata.openGraph.title || title },
  { property: 'og:description', content: metadata.openGraph.description },
  { property: 'og:url', content: metadata.openGraph.url },
  { property: 'og:site_name', content: metadata.openGraph.siteName },
  { property: 'og:locale', content: metadata.openGraph.locale },
  { property: 'og:type', content: metadata.openGraph.type },
  { property: 'og:image', content: metadata.openGraph.images[0]?.url },
  { name: 'twitter:card', content: metadata.twitter.card },
  { name: 'twitter:title', content: metadata.twitter.title || title },
  { name: 'twitter:description', content: metadata.twitter.description },
  { name: 'twitter:image', content: metadata.twitter.images[0] },
].filter((tag) => tag.content);

// Each entry is a JSON-LD string from generateStructuredData()
const structuredData = [].concat(seo.structuredData ?? []);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <GoogleAnalytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <title>{title}</title>
    {metaTags.map((tag) => <meta {...tag} />)}
    {!seo.noindex && <link rel="canonical" href={metadata.canonical} />}
    {structuredData.map((json) => <script type="application/ld+json" set:html={json} />)}

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <!-- SVG favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23FF6600'/%3E%3Cpath d='M7.5 12.2L16 8l8.5 4.2L16 16.4 7.5 12.2zm3 2.1v3.2c0 .8 2.4 2.8 5.5 2.8s5.5-2 5.5-2.8v-3.2L16 17.2 10.5 14.3zm14 0V19h-1.5v-3.4l1.5-1.2z' fill='white'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div id="root">
      <div class="">
        <Navbar pathname={pathname} />
        <main class="pt-20">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <script>
      // Web vitals reporting runs on localhost only, as in the original entry point
      const isLocalDev =
        window.location.hostname === 'localhost' ||
        window.location.hostname === '127.0.0.1';

      if (isLocalDev) {
        import('../utils/web-vitals').then(
          ({ reportWebVitals, detectLongTasks, checkPerformanceBudget }) => {
            reportWebVitals();
            detectLongTasks();
            checkPerformanceBudget();
          },
        );
      }
    </script>
  </body>
</html>
