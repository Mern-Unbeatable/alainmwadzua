---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTES } from '../config';

const faqData = [
  {
    question: "Can I really pay someone to take my online class?",
    answer: "Yes! Our elite class taker service assigns a subject expert to manage your entire syllabus securely and confidentially."
  },
  {
    question: "Is this service confidential?",
    answer: "Yes, our services are strictly confidential. We prioritize your privacy and ensure your personal information is protected."
  },
  {
    question: "What happens if I don't get a good grade?",
    answer: "We offer satisfaction guarantees and work closely with you to ensure top academic performance. Please refer to our refund policy for details."
  },
  {
    question: "How does the process work?",
    answer: "Simply submit your coursework details, receive a quote, make a payment, and our experts will handle the rest."
  },
  {
    question: "Can you help with urgent deadlines or a test due tonight?",
    answer: "Yes, we have a dedicated team for urgent requests to ensure you never miss a deadline."
  },
  {
    question: "How is pricing determined?",
    answer: "Pricing is based on the complexity, length, and deadline of your coursework or class."
  },
  {
    question: "Can you help with everything, including discussion posts?",
    answer: "Absolutely. We cover all aspects of online classes, including homework, quizzes, exams, and discussion posts."
  },
  {
    question: "Do you offer full course support packages?",
    answer: "Yes, we offer comprehensive packages where our experts manage your entire course from start to finish."
  },
  {
    question: "Will my school see a different IP address?",
    answer: "We use advanced VPN technologies to match your location, ensuring your login activity appears completely normal."
  }
];

// First question starts open, matching the original useState(0)
const INITIAL_OPEN_INDEX = 0;
const PANEL_BASE_CLASS = 'transition-all duration-300 ease-in-out';
const PANEL_OPEN_CLASS = 'max-h-40 opacity-100 pb-4';
const PANEL_CLOSED_CLASS = 'max-h-0 opacity-0';
---

<BaseLayout>
  <div class="w-full flex flex-col font-sans">
    {/* FAQ Section */}
    <div class="max-w-4xl mx-auto px-4 py-14 md:py-16 lg:py-20 w-full">
      <div class="text-center mb-10" data-reveal="text" style="--reveal-delay: 40ms">
        <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold text-[#1a202c] mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-[#4a5568] text-base px-4">
          Everything you need to know about our services, pricing, and how we ensure<br class="hidden md:block" /> your academic success.
        </p>
      </div>

      <div class="flex flex-col gap-2" id="faq-list" data-initial-open={INITIAL_OPEN_INDEX}>
        {
          faqData.map((faq, index) => {
            const isOpen = index === INITIAL_OPEN_INDEX;
            return (
              <div
                class="bg-[#FFF0E6] rounded-sm overflow-hidden"
                data-reveal="card"
                data-faq-item
                style={`--reveal-delay: ${80 + index * 45}ms`}
              >
                <button
                  data-faq-toggle
                  class="w-full flex justify-between items-center p-4 text-left focus:outline-none"
                >
                  <span class="text-black font-medium text-base">{faq.question}</span>
                  <span class="text-[#464E46] ml-4 transition-transform duration-200 shrink-0">
                    <svg
                      data-faq-icon="open"
                      hidden={!isOpen}
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg
                      data-faq-icon="closed"
                      hidden={isOpen}
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </button>

                <div
                  data-faq-panel
                  data-open-class={PANEL_OPEN_CLASS}
                  data-closed-class={PANEL_CLOSED_CLASS}
                  class={`${PANEL_BASE_CLASS} ${isOpen ? PANEL_OPEN_CLASS : PANEL_CLOSED_CLASS}`}
                >
                  <div class="px-4 text-base text-[#3C3C43D9] leading-relaxed">{faq.answer}</div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    {/* CTA Bottom Section */}
    <div
      class="relative w-full py-24 bg-cover bg-center flex items-center justify-center"
      data-reveal="card"
      style="--reveal-delay: 120ms; background-image: url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80')"
    >
      {/* Dark overlay */}
      <div class="absolute inset-0 bg-black/60"></div>

      {/* CTA Content */}
      <div class="relative z-10 text-center px-4" data-reveal="text" style="--reveal-delay: 180ms">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-3">Ready to Get Started?</h2>
        <p class="text-gray-200 text-sm md:text-base mb-8">
          Stop stressing over coursework. Let our experts handle it.
        </p>
        <a
          href={ROUTES.CONTACT}
          class="bg-[#FF6B00] hover:bg-[#e56000] text-white font-medium py-3 px-8 rounded transition duration-300 shadow-lg hover:scale-105 transform inline-block"
        >
          Get Help Now
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const items = Array.from(document.querySelectorAll('[data-faq-item]'));
  let openIndex = Number(
    document.getElementById('faq-list')?.dataset.initialOpen ?? -1,
  );

  const render = () => {
    items.forEach((item, index) => {
      const isOpen = index === openIndex;
      const panel = item.querySelector('[data-faq-panel]');
      if (panel) {
        const { openClass = '', closedClass = '' } = panel.dataset;
        panel.classList.remove(...openClass.split(' '), ...closedClass.split(' '));
        panel.classList.add(...(isOpen ? openClass : closedClass).split(' '));
      }
      item.querySelector('[data-faq-icon="open"]')?.toggleAttribute('hidden', !isOpen);
      item.querySelector('[data-faq-icon="closed"]')?.toggleAttribute('hidden', isOpen);
    });
  };

  items.forEach((item, index) => {
    item.querySelector('[data-faq-toggle]')?.addEventListener('click', () => {
      openIndex = openIndex === index ? -1 : index;
      render();
    });
  });
</script>
