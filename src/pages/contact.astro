---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactHeroSection from '../components/contact/ContactHeroSection.astro';
import ContactForm from '../components/contact/ContactForm.jsx';
import GuaranteesSection from '../components/contact/GuaranteesSection.astro';
---

<BaseLayout>
  <div class="w-full min-h-screen bg-white font-sans">
    <ContactHeroSection />

    {/* Main Form Content */}
    <div class="container mx-auto px-4 py-14 md:py-16 lg:py-20">
      <ContactForm client:load />

      <GuaranteesSection />
    </div>
  </div>
</BaseLayout>
