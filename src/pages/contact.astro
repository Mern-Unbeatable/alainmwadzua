---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactHeroSection from '../components/contact/ContactHeroSection.astro';
import ContactForm from '../components/contact/ContactForm.jsx';
import GuaranteesSection from '../components/contact/GuaranteesSection.astro';

const seo = {
  title: 'Contact Online Class Writers | Request a Quote',
  description:
    'Contact Online Class Writers to discuss your course, share your requirements and request a personalized quote for online class help.',
};
---

<BaseLayout seo={seo}>
  <div class="w-full min-h-screen bg-white font-sans">
    <ContactHeroSection />

    {/* Main Form Content */}
    <div class="container mx-auto px-4 py-14 md:py-16 lg:py-20">
      <ContactForm client:load />

      <GuaranteesSection />
    </div>
  </div>
</BaseLayout>
