---
import '../styles/global.css';
import { ROUTES, SEO_CONFIG } from '../config';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <title>{SEO_CONFIG.DEFAULT_TITLE}</title>
    <script is:inline>
      // Unknown blog posts used to redirect to the blog index; keep that behaviour.
      if (/^\/blog\/.+/.test(window.location.pathname)) {
        window.location.replace('/blog');
      }
    </script>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23FF6600'/%3E%3Cpath d='M7.5 12.2L16 8l8.5 4.2L16 16.4 7.5 12.2zm3 2.1v3.2c0 .8 2.4 2.8 5.5 2.8s5.5-2 5.5-2.8v-3.2L16 17.2 10.5 14.3zm14 0V19h-1.5v-3.4l1.5-1.2z' fill='white'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div id="root">
      <div class="flex flex-col items-center justify-center min-h-screen gap-4 text-center px-4">
        <h1 class="text-6xl font-bold text-gray-800">404</h1>
        <p class="text-xl text-gray-500">Page not found</p>
        <a href={ROUTES.HOME} class="mt-2 text-blue-600 hover:underline text-sm font-medium">
          Back to Home
        </a>
      </div>
    </div>
  </body>
</html>
