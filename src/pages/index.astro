---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealObserver from '../components/RevealObserver.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CustomQuoteSection from '../components/home/CustomQuoteSection.jsx';
import HowItWorksSection from '../components/home/HowItWorksSection.astro';
import WhyChooseSection from '../components/home/WhyChooseSection.astro';
import OnlineHelpCtaSection from '../components/home/OnlineHelpCtaSection.jsx';
import ServicesSection from '../components/home/ServicesSection.astro';
import ExpertTutorsSection from '../components/home/ExpertTutorsSection.astro';
import DisclaimerSection from '../components/home/DisclaimerSection.astro';
import { generateStructuredData } from '../utils/seo';
import { APP_CONFIG } from '../config';

const siteUrl = Astro.site.href;

const seo = {
  title: 'Online Class Help for US Students | Online Class Writers',
  description:
    'Explore online class support for US college students. Review available subjects, understand pricing, and contact Online Class Writers to discuss your needs.',
  structuredData: [
    generateStructuredData('Organization', {
      name: APP_CONFIG.NAME,
      url: siteUrl,
      areaServed: 'US',
    }),
    generateStructuredData('WebSite', {
      name: APP_CONFIG.NAME,
      url: siteUrl,
      inLanguage: 'en-US',
    }),
  ],
};
---

<BaseLayout seo={seo}>
  <HeroSection />

  <CustomQuoteSection client:load />

  <HowItWorksSection />

  <WhyChooseSection />

  <OnlineHelpCtaSection client:load />

  <ServicesSection />

  <ExpertTutorsSection />

  <DisclaimerSection />

  <RevealObserver />
</BaseLayout>
